# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ml_scoring
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/ml_scoring

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ml-scoring
MLFLOW_MODEL_REGISTRY_NAME=scoring-model

# Storage
ARTIFACT_STORE_PATH=./mlruns
DATASET_UPLOAD_PATH=./uploads

# Training defaults
DEFAULT_CV_FOLDS=5
STABILITY_WINDOW_COUNT=3
MIN_STABILITY_SCORE=0.02
ROC_AUC_FLOOR=0.70
TARGET_METRIC=roc_auc

# Drift thresholds
DRIFT_CHECK_INTERVAL_SECONDS=3600
PSI_THRESHOLD=0.2
KS_THRESHOLD=0.05
PERFORMANCE_DEGRADATION_THRESHOLD=0.03

# API
API_KEY_HEADER=X-API-Key
MAX_BATCH_PREDICT_SIZE=10000

# App
DEBUG=false
LOG_LEVEL=INFO
